" value="&lt;b&gt;16-bit error count&lt;/b&gt;&lt;br&gt;saturates at 65,535&lt;br&gt;no wraparound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3BD;strokeColor=#172033;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="610" y="300" width="220" height="125" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;busy / done&lt;br&gt;passed&lt;br&gt;error_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF0D8;strokeColor=#172033;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="245" height="130" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Decision&lt;/b&gt;&lt;br&gt;pass iff errors &amp;lt; threshold&lt;br&gt;equality is failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF0D8;strokeColor=#172033;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="320" width="245" height="105" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Independent UVM reference&lt;/b&gt;&lt;br&gt;separate polynomial/state update and exact lane/error prediction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E0F7;strokeColor=#172033;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;dashed=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="330" y="515" width="500" height="85" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#172033;dashed=0;fontFamily=Arial;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFDF5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="150" as="sourcePoint" /><mxPoint x="330" y="150" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rou