<mxfile host="app.diagrams.net" modified="2026-09-01T00:00:00.000Z" agent="journal/tools/build_figures.py" version="24.7.17"><diagram id="fig08_fpga_results" name="Page-1"><mxGraphModel dx="1200" dy="675" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="675" math="0" shadow="0" background="#FFFDF5"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Qualified FPGA implementation evidence" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontFamily=Arial;fontSize=25;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="200" y="5" width="800" height="40" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;Wide core top — negative result&lt;/b&gt;&lt;br&gt;Mapping: 763 logic elements&lt;br&gt;505 registers&lt;br&gt;151 external pins&lt;br&gt;Fitter: FAILED at 151 / 151 pins&lt;br&gt;No successful-fit timing claim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8D7DA;strokeColor=#172033;strokeWidth=2;fontFamily=Arial;fontSize=19;fontColor=#172033;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="480" height="230" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Compact CSR wrapper — fitted result&lt;/b&gt;&lt;br&gt;824 / 24,624 logic elements (3%)&lt;br&gt;505 registers&lt;br&gt;119 / 151 pins (79%)&lt;br&gt;Fitter: SUCCESS; zero virtual pins&lt;br&gt;Target: Cyclone 10 LP 10CL025YU256C8G" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF0D8;strokeColor=#172033;strokeWidth=2;fontFamily=Arial;fontSize=19;fontColor=#172033;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="80" width="480" height="230" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Internal-clock timing&lt;/b&gt;&lt;br&gt;80 MHz (12.5 ns constraint)&lt;br&gt;worst setup slack: +1.013 ns&lt;br&gt;worst hold slack: +0.179 ns&lt;br&gt;reported negative slack: 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7E396;strokeColor=#172033;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="365" width="480" height="140" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Why the wrapper changes feasibility&lt;/b&gt;&lt;br&gt;Wide debug/status buses consume package pins&lt;br&gt;CSR serializes diagnostics into byte reads&lt;br&gt;Logic cost rises slightly; pin demand falls by 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3BD;strokeColor=#172033;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;dashed=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="365" width="480" height="140" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Qualification&lt;/b&gt;&lt;br&gt;No board pin locations or external I/O delays → internal timing evidence only; not board closure, ASIC PPA, or UCIe PHY performance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECEF;strokeColor=#172033;strokeWidth=2;fontFamily=Arial;fontSize=17;fontColor=#172033;dashed=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1080" height="65" as="geometry" /></mxCell><mxCell id="e1" value="replace wide diagnostics with CSR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#172033;dashed=1;fontFamily=Arial;fontSize=14;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="195" as="sourcePoint" /><mxPoint x="660" y="195" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
